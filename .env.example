# Copia a .env y ajusta. Solo para desarrollo local; en Cloud Run las claves vienen de Secret Manager.
CLAVES_API=clave-local
GOOGLE_CLOUD_PROJECT=cv-agent-xxxx
GOOGLE_CLOUD_LOCATION=global
MODELO_GEMINI=gemini-3.5-flash
NIVEL_RAZONAMIENTO=LOW
MAX_TOKENS_SALIDA=2048
LIMITE_POR_MINUTO=60
LIMITE_RAFAGA=20
PRESUPUESTO_TOKENS_DIARIO=5000000
REGISTRAR_PREGUNTAS=false
